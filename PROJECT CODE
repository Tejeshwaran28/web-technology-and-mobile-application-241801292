function getMockProducts(query) {
  const q = query.toLowerCase();
  let pool = [];
  for (const key in PRODUCT_TEMPLATES) {
    if (q.includes(key) || key.includes(q.replace(/\s/g, ''))) {
      pool = PRODUCT_TEMPLATES[key];
      break;
    }
  }
  if (pool.length === 0) pool = PRODUCT_TEMPLATES["default"];
  // add some randomization so each search feels slightly different
  return pool.map((p, i) => ({
    id: i + 1,
    title: p.title,
    brand: p.brand,
    price: p.price + Math.floor(Math.random() * 50 - 25),
    rating: { rate: p.rating, count: p.reviews + Math.floor(Math.random() * 200) },
    category: query.toLowerCase().split(' ')[0] || 'general',
    description: `Latest ${p.brand} ${query} with top-tier specs, excellent reviews, and competitive pricing from ${p.source}.`,
    image: p.img,
    source: p.source,
  }));
}

// ---- Supabase real backend attempt ----
async function searchProductsOnline(query) {
  const SUPABASE_URL = "https://pmtdcsiwodhipeadyhrg.supabase.co";
  try {
    const res = await fetch(`${SUPABASE_URL}/functions/v1/search-products`, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ query }),
    });
    if (!res.ok) throw new Error("Backend unavailable");
    const data = await res.json();
    if (data.error) throw new Error(data.error);
    return (data.products || []).map((p, i) => ({
      id: p.id ?? i + 1,
      title: p.title,
      brand: p.brand,
      price: Number(p.price) || 0,
      description: p.description ?? "",
      category: (p.category ?? "general").toLowerCase(),
      image: p.image && /^https?:\/\//.test(p.image) ? p.image : `https://source.unsplash.com/400x400/?${encodeURIComponent(p.title.split(" ").slice(0,3).join(","))}`,
      rating: { rate: Number(p.rating) || 0, count: Number(p.reviews) || 0 },
      source: p.source,
    }));
  } catch (e) {
    // fallback to rich mock data
    console.log("Using offline mock data for demo");
    return getMockProducts(query);
  }
}

function generatePriceHistory(p, months = 7) {
  const seed = p.id * 9301 + 49297;
  const data = [];
  const labels = ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"];
  const now = new Date().getMonth();
  for (let i = months - 1; i >= 0; i--) {
    const idx = (now - i + 12) % 12;
    const noise = (Math.sin(seed + i * 1.7) + 1) / 2;
    const variance = 0.22;
    const factor = 1 - variance / 2 + noise * variance;
    data.push({ month: labels[idx], price: +(p.price * factor).toFixed(2) });
  }
  data.push({ month: "Now", price: p.price });
  return data;
}

