              type="submit"
              disabled={loading || !query.trim()}
              className="absolute right-2 top-1/2 -translate-y-1/2 h-12 px-6 rounded-xl text-white font-medium gradient-primary glow disabled:opacity-40 disabled:shadow-none transition"
            >
              {loading ? <span className="inline-block w-4 h-4 border-2 border-white/30 border-t-white rounded-full animate-spin" /> : "Search"}
            </button>
          </form>

          {errorMsg && (
            <div className="mt-4 text-sm text-red-600 bg-red-50 border border-red-200 rounded-xl py-2 px-4 inline-block">{errorMsg}</div>
          )}

          {!hasSearched && (
            <div className="mt-6 flex flex-wrap justify-center gap-2 max-w-xl mx-auto">
              <span className="text-xs text-muted-foreground self-center">Try:</span>
              {SUGGESTIONS.map((s) => (
                <button key={s} onClick={() => { setQuery(s); runSearch(s); }} className="px-3 py-1.5 rounded-full text-xs font-medium bg-card border border-border text-muted-foreground hover:border-primary/50 hover:text-foreground transition">
                  {s}
                </button>
              ))}
            </div>
          )}

          {hasSearched && categories.length > 1 && (
            <div className="mt-6 flex flex-wrap justify-center gap-2">
              {categories.map((c) => (
                <button key={c} onClick={() => setCategory(c)} className={`px-4 py-1.5 rounded-full text-xs font-medium capitalize transition ${category === c ? 'gradient-primary text-white glow' : 'bg-card border border-border text-muted-foreground hover:border-primary/50'}`}>
                  {c.replace(/-/g, " ")}
                </button>
              ))}
            </div>
          )}
        </div>
      </header>

      <main className="max-w-6xl mx-auto px-4 pb-32 pt-8">
        {hasSearched && (
          <div className="flex items-end justify-between mb-6">
            <div>
              <h2 className="font-display text-2xl font-bold">{loading ? "Searching..." : `${filtered.length} result${filtered.length !== 1 ? "s" : ""}`}</h2>
              <p className="text-sm text-muted-foreground">{selected.length > 0 ? `${selected.length} selected` : "Tap Compare on any product"}</p>
            </div>
            {selected.length >= 2 && (
              <button onClick={() => setShowCompare(true)} className="px-5 py-2.5 rounded-xl text-sm font-medium text-white gradient-primary glow">
                View Comparison
              </button>
            )}
          </div>
        )}

        {loading ? (
          <div className="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-5">
            {Array.from({ length: 8 }).map((_, i) => (
              <div key={i} className="aspect-[3/4] rounded-2xl bg-muted pulse-skeleton" />
            ))}
          </div>
        ) : !hasSearched ? (
          <div className="text-center py-20 text-muted-foreground">
            <div className="text-5xl mb-4 opacity-30">🔍</div>
            <p>Search any product to start comparing.</p>
          </div>
        ) : filtered.length === 0 ? (
          <div className="text-center py-20">
            <p className="text-muted-foreground">No products found. Try a different search.</p>
          </div>
        ) : (
          <div className="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-5">
            {filtered.map((p) => (
              <ProductCard key={p.id} product={p} selected={!!selected.find((x) => x.id === p.id)} onToggle={toggle} />
            ))}
          </div>
        )}
      </main>

      <CompareDrawer selected={selected} onRemove={toggle} onClear={() => setSelected([])} onCompare={() => setShowCompare(true)} />
      <CompareModal open={showCompare} onOpenChange={setShowCompare} products={selected} />

      <footer className="border-t border-border py-6 text-center text-xs text-muted-foreground">
        Built with ♥ — Web Technology project · Live search powered by AI
      </footer>
    </div>
  );
};

const root = ReactDOM.createRoot(document.getElementById('root'));
root.render(<App />);
</script>
</body>
</html>
